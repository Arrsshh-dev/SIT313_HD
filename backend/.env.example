# Backend Environment Variables (Render / Local)
PORT=3000

# CORS Allowed Origin (set to your Netlify URL in production)
FRONTEND_URL=https://devdeakin-web.netlify.app

# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_verified_sender_email@example.com

# Firebase Admin Service Account Key JSON (as a single-line string for Render cloud)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"sit313-p4-6b84e",...}
